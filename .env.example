APP_ENV=development
PORT=8000

# PostgreSQL 
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg2://app:change-me-db-password@db:5432/app

SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_MINUTES=60

# Хэширование паролей
HASH_SCHEME=argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
BCRYPT_ROUNDS=12
